<?xml version="1.0" encoding="utf-8"?>
<!-- The hex lattice patterns are drawn on. Drawing and input: GridSurface in hex_grid.rs. -->
<Component name="HexGrid"
           description="@Strings.component.hex_grid"
           icon="item:amethyst_shard"
           design_w="240"
           design_h="180">
    <Property name="source"
              type="text"
              default="hexcasting:casting_grid"
              doc="Id of the registered grid surface (GridSurface::ID)" />
    <Surface w="100%" h="100%" source="{x:Bind source}" />
</Component>
