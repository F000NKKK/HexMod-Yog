<?xml version="1.0" encoding="utf-8"?>
<!-- A drawn pattern: what it was and its angle signature. -->
<Component name="PatternEntry"
           description="@Strings.component.pattern_entry"
           icon="item:paper"
           design_w="150"
           design_h="11">
    <Property name="name" type="text" default="Mind's Reflection" doc="The pattern's name" />
    <Property name="signature" type="text" default="qaq" doc="Its angle signature" />
    <Property name="accent" type="color" default="#FF4FD67A" doc="Result colour" category="Appearance" />
    <Row w="100%" h="11" gap="4" align="center">
        <Spacer w="2" h="9" bg="{x:Bind accent}" />
        <Label flex="1" text="{x:Bind name}" color="#FFDDDDDD" shadow="false" ellipsis="true" />
        <Label text="{x:Bind signature}" color="#FF777788" shadow="false" no_wrap="true" />
    </Row>
</Component>
