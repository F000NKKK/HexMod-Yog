<?xml version="1.0" encoding="utf-8"?>
<!-- A one-line cast result: green for a working pattern, red for a mishap. -->
<Component name="MishapBanner"
           description="@Strings.component.mishap_banner"
           icon="item:redstone"
           design_w="150"
           design_h="14">
    <Property name="text" type="text" default="Mishap: the stack is empty" doc="The message" />
    <Property name="accent" type="color" default="#FFE05A4F" doc="Mark and text colour" category="Appearance" />
    <Row w="100%" h="14" padding="0 4" gap="4" align="center" bg="#CC1C1C26">
        <Spacer w="2" h="10" bg="{x:Bind accent}" />
        <Label flex="1" text="{x:Bind text}" color="{x:Bind accent}" shadow="false" ellipsis="true" />
    </Row>
</Component>
